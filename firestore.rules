rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAdminRole() {
      return signedIn()
        && (
          request.auth.token.get('role', '') in ['admin', 'super_admin']
          || (
            request.auth.token.get('roles', []) is list
            && request.auth.token.get('roles', []).hasAny(['admin', 'super_admin'])
          )
        );
    }

    function hasActiveMobileDevice() {
      return signedIn()
        && request.auth.token.get('device_id', '') is string
        && request.auth.token.get('device_id', '') != ''
        && exists(/databases/$(database)/documents/device_bindings/$(request.auth.uid))
        && get(/databases/$(database)/documents/device_bindings/$(request.auth.uid)).data.get('device_id', '')
          == request.auth.token.get('device_id', '');
    }

    function customerSignedIn() {
      return hasAdminRole() || hasActiveMobileDevice();
    }

    function ownsRecord() {
      return customerSignedIn() && resource.data.get('user_id', '') == request.auth.uid;
    }

    // Catalog metadata is readable to signed-in customers only while active.
    // Administrators can read and manage active or soft-deleted records.
    match /books/{bookId} {
      allow read: if hasAdminRole()
        || (customerSignedIn() && resource.data.get('deleted_at', null) == null);
      allow create, update, delete: if hasAdminRole();
    }

    match /games/{gameId} {
      allow read: if hasAdminRole()
        || (customerSignedIn() && resource.data.get('deleted_at', null) == null);
      allow create, update, delete: if hasAdminRole();

      match /game_cards/{cardId} {
        // Card contents are delivered by getProtectedGameContent after the
        // Cloud Function verifies the user's purchase or access entitlement.
        allow read: if hasAdminRole();
        allow create, update, delete: if hasAdminRole();
      }
      match /game_rules/{ruleId} {
        allow read: if hasAdminRole();
        allow create, update, delete: if hasAdminRole();
      }
    }

    match /pillars/{pillarId} {
      allow read: if hasAdminRole()
        || (customerSignedIn() && resource.data.get('deleted_at', null) == null);
      allow create, update, delete: if hasAdminRole();
    }

    match /categories/{categoryId} {
      allow read: if hasAdminRole()
        || (customerSignedIn() && resource.data.get('deleted_at', null) == null);
      allow create, update, delete: if hasAdminRole();
    }

    match /game_rules/{ruleId} {
      allow read: if hasAdminRole();
      allow create, update, delete: if hasAdminRole();
    }

    match /game_placements/{placementId} {
      allow read: if customerSignedIn();
      allow create, update, delete: if hasAdminRole();
    }

    // Profile documents are owner-readable. Users may update profile display
    // fields only; access/role/verification flags remain server-controlled.
    match /users/{userId} {
      allow read: if hasAdminRole() || (hasActiveMobileDevice() && request.auth.uid == userId);
      allow create: if hasActiveMobileDevice()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'full_name', 'role', 'membership_tier', 'email_verified', 'disabled', 'created_at', 'updated_at'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.membership_tier == 'regular'
        && request.resource.data.email_verified == request.auth.token.get('email_verified', false)
        && request.resource.data.disabled == false;
      allow delete: if false;
      allow update: if hasActiveMobileDevice()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'avatar_path', 'updated_at'])
        && request.resource.data.get('role', resource.data.get('role', 'user'))
          == resource.data.get('role', 'user')
        && request.resource.data.get('membership_tier', resource.data.get('membership_tier', 'regular'))
          == resource.data.get('membership_tier', 'regular')
        && request.resource.data.get('disabled', resource.data.get('disabled', false))
          == resource.data.get('disabled', false)
        && request.resource.data.get('email_verified', resource.data.get('email_verified', false))
          == resource.data.get('email_verified', false);
    }

    // Payment submission records are read-only from the clients. Trusted
    // callables validate item price, cart totals, ownership, and review status.
    match /payment_submissions/{paymentId} {
      allow read: if hasAdminRole() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /game_payment_submissions/{paymentId} {
      allow read: if hasAdminRole() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /book_purchases/{purchaseId} {
      allow read: if hasAdminRole() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /game_purchases/{purchaseId} {
      allow read: if hasAdminRole() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /user_book_access/{accessId} {
      allow read: if hasAdminRole() || ownsRecord();
      allow create, update, delete: if false;
    }

    match /user_game_access/{accessId} {
      allow read: if hasAdminRole() || ownsRecord();
      allow create, update, delete: if false;
    }

    // Mobile clients can retrieve payment configuration needed at checkout.
    // Settings mutations and audit history are Cloud-Function-only.
    match /app_settings/{settingId} {
      allow read: if hasAdminRole()
        || (customerSignedIn() && settingId == 'payment_settings');
      allow create, update, delete: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if false;
    }

    match /device_bindings/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
