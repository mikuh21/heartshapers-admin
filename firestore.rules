rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAdminRole() {
      return signedIn()
        && (
          request.auth.token.get('role', '') in ['admin', 'super_admin']
          || (
            request.auth.token.get('roles', []) is list
            && request.auth.token.get('roles', []).hasAny(['admin', 'super_admin'])
          )
        );
    }

    // Admin dashboard data. Privileged app settings and audit records are
    // accessed through callable Cloud Functions, not direct client writes.
    match /books/{bookId} {
      allow read, create, update, delete: if hasAdminRole();
    }

    match /games/{gameId} {
      allow read, create, update, delete: if hasAdminRole();
      match /game_cards/{cardId} {
        allow read, write: if hasAdminRole();
      }
    }

    match /pillars/{pillarId} {
      allow read, create, update, delete: if hasAdminRole();
    }

    match /categories/{categoryId} {
      allow read, create, update, delete: if hasAdminRole();
    }

    match /payment_submissions/{paymentId} {
      allow read: if hasAdminRole();
      allow write: if false;
    }

    match /game_payment_submissions/{paymentId} {
      allow read: if hasAdminRole();
      allow write: if false;
    }

    // User records, purchases, app settings, and audit logs are managed via
    // trusted Cloud Functions or separate client rules scoped to the user app.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /book_purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /game_purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /app_settings/{settingId} {
      allow read, write: if false;
    }

    match /admin_logs/{logId} {
      allow read, write: if false;
    }

    // Default deny: all collections not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}